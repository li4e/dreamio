{
  "name": "dreamio",
  "version": "0.0.1",
  "author": "li4e",
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "start": "npm run start -w apps/mobile",
    "ios": "dotenv -e .env -- npm run ios -w apps/mobile",
    "android": "dotenv -e .env -- npm run android -w apps/mobile",
    "ios:release": "dotenv -e .env -- npm run ios:release -w apps/mobile",
    "android:release": "dotenv -e .env -- npm run android:release -w apps/mobile",
    "prebuild": "dotenv -e .env -- npm run prebuild -w apps/mobile",
    "prebuild:screenshots": "npm run prebuild && npm run build -w tools/screenshots",
    "deploy:web": "firebase deploy --only hosting",
    "deploy:ios": "npm run prebuild && dotenv -e .env -- npm run deploy:ios -w tools/mobile-deploy",
    "deploy:meta": "dotenv -e .env -- npm run deploy:meta -w tools/mobile-deploy",
    "deploy:screenshots": "dotenv -e .env -- npm run deploy:screenshots -w tools/mobile-deploy",
    "screenshots": "npm run start -w tools/screenshots",
    "translate": "dotenv -e .env -- npm run translate -w tools/translator"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "patch-package": "^8.0.0"
  }
}
