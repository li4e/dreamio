{
  "sourceLanguage" : "en",
  "strings" : {
    "NSUserNotificationsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like to receive notifications to stay updated on new posts, likes, comments, and when your creations are ready?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите получать уведомления, чтобы быть в курсе новых постов, лайков, комментариев и готовых генераций?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бажаєте отримувати сповіщення, щоб бути в курсі нових дописів, вподобань, коментарів та готових генерацій?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您是否希望接收通知，以便随时了解新帖子、点赞、评论以及您的创作完成情况？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您是否希望接收通知，以便隨時了解新帖子、喜歡、評論以及您的創作完成情況？"
          }
        }
      }
    }
  },
  "version" : "1.0"
}