{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api/src",
  "projectType": "application",
  "tags": ["firebase:function", "firebase:name:api", "firebase:dep:firebase"],
  "targets": {
    "prepare": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run db:prepare && npx tsoa routes && npx tsoa spec && openapi-generator-cli generate -i ./__generated/swagger.json -g typescript-axios -o ../api-client/__generated",
        "cwd": "packages/api"
      }
    },

    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/api",
        "main": "packages/api/src/server.ts",
        "tsConfig": "packages/api/tsconfig.app.json",
        "assets": [
          "packages/api/src/assets",
          {
            "glob": "**/*",
            "input": "packages/firebase/environment",
            "output": "."
          }
        ],
        "generatePackageJson": true,
        "platform": "node",
        "bundle": true,
        "thirdParty": false,
        "dependenciesFieldType": "dependencies",
        "target": "node20",
        "format": ["esm"],
        "esbuildOptions": {
          "logLevel": "info",
          "banner": {
            "js": "const require = (await import('node:module')).createRequire(import.meta.url);const __filename = (await import('node:url')).fileURLToPath(import.meta.url);const __dirname = (await import('node:path')).dirname(__filename);"
          }
        }
      },
      "dependsOn": ["prepare"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/api/jest.config.ts",
        "runInBand": true
      },
      "dependsOn": ["prepare"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run firebase:deploy --only functions:api"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc -p tsconfig.app.json --noEmit"],
        "cwd": "packages/api",
        "forwardAllArgs": false
      }
    }
  }
}
