generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESS_CONNECTION_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  freeCredits    Int             @default(1)
  firebaseUsers  FirebaseUser[]
  subscriptions  Subscription[]  @relation("UserSubscriptions")
  inAppPurchases InAppPurchase[] @relation("UserInAppPurchases")
}

model FirebaseUser {
  id         Int    @id @default(autoincrement())
  firebaseId String @unique
  userId     Int
  user       User   @relation(fields: [userId], references: [id])
}

enum Store {
  app_store
  play_store
  adapty
}

model Subscription {
  id                      Int     @id @default(autoincrement())
  product_id              String
  transaction_Id          String
  original_transaction_id String
  store                   Store
  is_active               Boolean
  is_lifetime             Boolean
  is_in_trial             Boolean
  is_in_grace_period      Boolean
  will_renew              Boolean
  is_sandbox              Boolean
  base_plan_id            String?

  users User[] @relation("UserSubscriptions")

  @@unique([store, original_transaction_id])
}

model InAppPurchase {
  id                      Int     @id @default(autoincrement())
  product_id              String
  transaction_id          String
  original_transaction_id String
  store                   Store
  is_refunded             Boolean
  is_sandbox              Boolean
  users                   User[]  @relation("UserInAppPurchases")

  @@unique([store, original_transaction_id])
}
