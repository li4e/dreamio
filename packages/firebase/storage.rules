rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/temp/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 1024 * 100 // less than 100kb
                   && request.resource.contentType.matches('image/jpeg'); // только изображения
    }

  }
}
