generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "darwin-arm64"]
    output        = "../generated/client"
}

generator model {
    provider                        = "prisma-generator-nestjs-dto"
    output                          = "../generated/models"
    outputToNestJsResourceStructure = "false"
    flatResourceStructure           = "false"
    exportRelationModifierClasses   = "false"
    reExport                        = "false"
    createDtoPrefix                 = "Create"
    updateDtoPrefix                 = "Update"
    dtoSuffix                       = "Dto"
    entityPrefix                    = ""
    entitySuffix                    = ""
    classValidation                 = "false"
    fileNamingStyle                 = "camel"
    noDependencies                  = "true"
    outputType                      = "interface"
    definiteAssignmentAssertion     = "false"
    requiredResponseApiProperty     = "true"
    prettier                        = "true"
}

datasource db {
    provider = "postgresql"
    url      = env("POSTGRESS_CONNECTION_URL")
}

model User {
    id          Int @id @default(autoincrement())
    freeCredits Int @default(1)

    firebaseUsers  FirebaseUser[]
    subscriptions  Subscription[]    @relation("UserSubscriptions")
    inAppPurchases InAppPurchase[]   @relation("UserInAppPurchases")
    generations    Generation[]
    likedPosts     PostLike[]
    likesComments  PostCommentLike[]
    comments       PostComment[]
    postsClaims    PostClaim[]
    commentsClaims CommentClaim[]
}

model FirebaseUser {
    firebaseId String @unique
    userId     Int

    user User @relation(fields: [userId], references: [id])

    @@unique([firebaseId, userId])
}

enum Store {
    app_store
    play_store
    adapty
}

model Subscription {
    id                      Int     @id @default(autoincrement())
    product_id              String
    transaction_id          String
    original_transaction_id String
    store                   Store
    is_active               Boolean
    is_lifetime             Boolean
    is_in_trial             Boolean
    is_in_grace_period      Boolean
    will_renew              Boolean
    is_sandbox              Boolean
    base_plan_id            String?
    credits                 Int
    version                 Int     @default(0)

    users User[] @relation("UserSubscriptions")

    @@unique([store, original_transaction_id])
}

model InAppPurchase {
    id                      Int     @id @default(autoincrement())
    product_id              String
    transaction_id          String
    original_transaction_id String
    store                   Store
    is_refunded             Boolean
    is_sandbox              Boolean
    credits                 Int
    users                   User[]  @relation("UserInAppPurchases")
    version                 Int     @default(0)

    @@unique([store, original_transaction_id])
}

model Image {
    id              Int              @id @default(autoincrement())
    filePath        String           @unique @map("file_path")
    publicUrl       String           @map("public_url")
    imageGeneration ImageGeneration?
}

enum Status {
    processing
    completed
    error
}

enum GenerationModel {
    dalle_2
    dalle_3
}

model ImageGeneration {
    imageId      Int        @id @unique @map("image_id")
    generationId Int        @map("generation_id")
    generation   Generation @relation(fields: [generationId], references: [id])
    image        Image      @relation(fields: [imageId], references: [id])
}

model Generation {
    id          Int             @id @default(autoincrement())
    /// @DtoRelationIncludeId
    userId      Int             @map("user_id")
    promptFull  String          @db.VarChar(1000)
    prompt      String          @db.VarChar(500)
    style       String?         @db.VarChar(255)
    model       GenerationModel
    n           Int             @default(1)
    highQuality Boolean?
    enhancer    Boolean
    status      Status          @default(processing)
    createdAt   DateTime        @default(now()) @map("created_at")
    updatedAt   DateTime        @updatedAt @map("updated_at")

    images ImageGeneration[]
    user   User              @relation(fields: [userId], references: [id])
    Post   Post[]
}

model Post {
    id                Int      @id @default(autoincrement())
    generationId      Int      @map("generation_id")
    imageGenerationId Int      @map("image_generation_id")
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")
    likesCount        Int      @default(0) @map("likes_count")
    commentsCount     Int      @default(0) @map("comments_count")

    deleted Boolean @default(false)
    blocked Boolean @default(false)

    likes    PostLike[]
    comments PostComment[]

    generation Generation @relation(fields: [generationId], references: [id])

    claims PostClaim[]

    @@unique([generationId, imageGenerationId])
}

model PostLike {
    postId Int @map("post_id")
    userId Int @map("user_id")

    post Post @relation(fields: [postId], references: [id])
    user User @relation(fields: [userId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([userId, postId])
}

model PostComment {
    id         BigInt @id @default(autoincrement())
    postId     Int    @map("post_id")
    userId     Int    @map("user_id")
    content    String @db.Text
    likesCount Int    @default(0) @map("likes_count")
    childCount Int    @default(0) @map("child_count")

    deleted Boolean @default(false)
    blocked Boolean @default(false)

    parentId BigInt? @map("parent_id")
    replyId  BigInt? @map("reply_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    post Post @relation(fields: [postId], references: [id])
    user User @relation(fields: [userId], references: [id])

    parentComment PostComment?  @relation("ParentChildRelation", fields: [parentId], references: [id])
    childComments PostComment[] @relation("ParentChildRelation")

    replyComment PostComment?      @relation("ReplyRelation", fields: [replyId], references: [id])
    replies      PostComment[]     @relation("ReplyRelation")
    likes        PostCommentLike[]

    claims CommentClaim[]
}

model PostCommentLike {
    commentId BigInt @map("comment_id")
    userId    Int    @map("user_id")

    comment PostComment @relation(fields: [commentId], references: [id])
    user    User        @relation(fields: [userId], references: [id])

    @@unique([userId, commentId])
}

enum ClaimStatus {
    pending
    accepted
    rejected
}

model PostClaim {
    id        Int         @id @default(autoincrement())
    postId    Int         @map("post_id")
    userId    Int         @map("user_id")
    reason    String      @db.Char(255)
    status    ClaimStatus @default(pending)
    createdAt DateTime    @default(now()) @map("created_at")
    updatedAt DateTime    @updatedAt @map("updated_at")

    post Post @relation(fields: [postId], references: [id])
    user User @relation(fields: [userId], references: [id])

    @@unique([userId, postId])
}

model CommentClaim {
    id        Int         @id @default(autoincrement())
    commentId BigInt      @map("comment_id")
    userId    Int         @map("user_id")
    reason    String      @db.Text
    status    ClaimStatus @default(pending)
    createdAt DateTime    @default(now()) @map("created_at")
    updatedAt DateTime    @updatedAt @map("updated_at")

    comment PostComment @relation(fields: [commentId], references: [id])
    user    User        @relation(fields: [userId], references: [id])

    @@unique([userId, commentId])
}
