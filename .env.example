# .env.example

# APP_NAME: The name used internally in iOS/Android projects. 
# This is not the display name seen by the user when the app is installed.
# It influences the file paths used during builds (e.g., workspace paths).
APP_NAME=exampleapp

# APP_VERSION: The version number of the app, which is shown to the user and used for versioning.
APP_VERSION=1.0.0

# BUILD_NUMBER: The build number for the app. This should be incremented with each new build.
APP_BUILD_NUMBER=1

# IOS_APP_IDENTIFIER: The unique identifier for the app in the Apple App Store.
# This is also known as the bundle identifier.
IOS_APP_IDENTIFIER=com.exampleapp.ios

# APPLE_ITC_TEAM_ID: The team ID for your Apple Developer account.
APPLE_ITC_TEAM_ID=123456789

# APPLE_TEAM_ID: The Apple Team ID associated with your account. Used for authentication in App Store Connect.
APPLE_TEAM_ID=AB123CDE45

# APPLE_API_KEY_ID: The ID for the Apple API key used for authentication when accessing App Store Connect.
APPLE_API_KEY_ID=ABCDE12345

# APPLE_API_KEY_ISSUER_ID: The issuer ID for your Apple API key.
APPLE_API_KEY_ISSUER_ID=12345678-90ab-cdef-1234-567890abcdef

# APPLE_API_KEY_FILEPATH: The local path to the Apple API key file used for authentication.
# Ensure this path is valid for your local setup.
APPLE_API_KEY_FILEPATH=~/keys/AuthKey_ABCDE12345.p8

# ANDROID_APP_IDENTIFIER: The unique identifier (package name) for the Android app.
ANDROID_APP_IDENTIFIER=com.exampleapp.android

# ANDROID_SUPPLY_KEY: The local path to the JSON key file used for authentication with Google Play Console.
# Required for automating app uploads and metadata updates.
ANDROID_SUPPLY_KEY=~/keys/fastlane-supply.json

# CERTIFICATES_GIT_REP: The URL of the Git repository where your certificates are stored.
CERTIFICATES_GIT_REP=git@github.com:exampleuser/example_certificates.git

# OPENAI_API_KEY: Using for translation app's metadata, dictionary
OPENAI_API_KEY=ABCDE